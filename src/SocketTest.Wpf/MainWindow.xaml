<Window x:Class="SocketTest.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SocketTest.Wpf.Views"
        Title="{Binding Title}"
        Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="6">
        <TabItem Header="TCP Client">
            <views:TcpClientView DataContext="{Binding TcpClient}" />
        </TabItem>
        <TabItem Header="TCP Server">
            <views:TcpServerView DataContext="{Binding TcpServer}" />
        </TabItem>
        <TabItem Header="UDP">
            <views:UdpView DataContext="{Binding Udp}" />
        </TabItem>
        <TabItem Header="About">
            <views:AboutView />
        </TabItem>
    </TabControl>
</Window>
