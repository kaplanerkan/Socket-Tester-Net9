<UserControl x:Class="SocketTest.Wpf.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#BBB" BorderThickness="1" Background="#FFFBFDFF">
        <ListBox x:Name="LogList"
                 ItemsSource="{Binding Entries}"
                 FontFamily="Consolas"
                 FontSize="12"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="False"
                 ScrollViewer.CanContentScroll="False"
                 SelectionMode="Extended"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.InputBindings>
                <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy" />
            </ListBox.InputBindings>
            <ListBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" />
            </ListBox.CommandBindings>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy selected" InputGestureText="Ctrl+C" Click="OnCopySelectedClick" />
                    <MenuItem Header="Copy selected with timestamp" Click="OnCopySelectedFullClick" />
                    <Separator />
                    <MenuItem Header="Copy all" Click="OnCopyAllClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss.fff}"
                                   Foreground="#888" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Direction}"
                                   Width="64"
                                   FontWeight="Bold"
                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToBrush}}" />
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToBrush}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
