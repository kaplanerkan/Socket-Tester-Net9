<Window x:Class="SocketTest.Wpf.Views.EntrySampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entry Sample"
        Height="380" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Text="Sample payloads. Double-click a line to copy its JSON into the Send box, or select text manually." />

        <TextBox Grid.Row="1"
                 x:Name="SamplesBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="OnSamplesDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Copy selection" Width="120" Margin="0,0,6,0" Click="OnCopySelectionClick" />
            <Button Content="Copy all" Width="90" Margin="0,0,6,0" Click="OnCopyAllClick" />
            <Button Content="Close" Width="90" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
