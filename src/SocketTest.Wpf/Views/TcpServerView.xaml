<UserControl x:Class="SocketTest.Wpf.Views.TcpServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SocketTest.Wpf.Views">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Bind:" />
            <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsListening, Converter={x:Static views:InverseBoolConverter.Instance}}" />
            <Label Grid.Column="2" Content="Port:" Margin="8,0,0,0" />
            <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsListening, Converter={x:Static views:InverseBoolConverter.Instance}}" />
            <Button Grid.Column="4" Content="Start" Command="{Binding StartCommand}" Margin="10,0,6,0" />
            <Button Grid.Column="5" Content="Stop" Command="{Binding StopCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="Encoding:" />
            <ComboBox Width="120" ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding Encoding}" />
            <Label Content="Line ending:" Margin="12,0,0,0" />
            <ComboBox Width="90" ItemsSource="{Binding LineEndingOptions}" SelectedItem="{Binding LineEnding}" />
        </StackPanel>

        <views:ConversationView Grid.Row="2" DataContext="{Binding Log}" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Send:" />
            <TextBox Grid.Column="1" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Save..." Command="{Binding SaveCommand}" Margin="0,0,6,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
