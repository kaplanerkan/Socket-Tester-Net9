<UserControl x:Class="SocketTest.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock Text="SocketTest.NET" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="A .NET 9 / WPF socket tester by Erkan Kaplan."
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            TCP client, TCP server, and UDP send/receive in one window. Supports UTF-8 / Windows-1252 / ASCII / Hex
            encodings and selectable CRLF / LF / none line endings. TCP client can negotiate SSL with an
            interactive trust prompt for self-signed certificates.
        </TextBlock>
        <TextBlock Text="Built with .NET 9, WPF, MVVM." Foreground="#666" />
    </StackPanel>
</UserControl>
