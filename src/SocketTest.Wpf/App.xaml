<Application x:Class="SocketTest.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SocketTest.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:DirectionToBrushConverter x:Key="DirectionToBrush" />
        <conv:TruncateTextConverter x:Key="TruncateText" MaxChars="1500" />

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Application.Resources>
</Application>
